#!/usr/bin/env python3
"""Run ROM regression tests with the OpenSn-compatible test harness."""

import os
import sys
from pathlib import Path


def main():
    rom_root = Path(__file__).resolve().parents[1]
    repository_root = rom_root.parent
    runner = repository_root / "diffusion" / "test" / "run_tests"

    arguments = list(sys.argv[1:])
    if "--exe" in arguments:
        os.environ["ROM_APP_EXEC"] = os.path.abspath(arguments[arguments.index("--exe") + 1])
    if "--exe" not in arguments:
        executable = os.environ.get("ROM_APP_EXEC", str(rom_root / "build" / "rom_app_exec"))
        os.environ["ROM_APP_EXEC"] = os.path.abspath(executable)
        arguments.extend(["--exe", executable])
    if "-d" not in arguments and "--directory" not in arguments and "-t" not in arguments:
        arguments.extend(["--directory", str(Path(__file__).resolve().parent / "rom")])
    if "--mpi-cmd" not in arguments:
        launcher = Path(__file__).resolve().parent / "launch_test"
        arguments.extend(["--mpi-cmd", str(launcher)])

    os.execv(sys.executable, [sys.executable, str(runner), *arguments])


if __name__ == "__main__":
    main()
